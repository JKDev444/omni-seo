DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Login is username/password (scripts/createUser.ts creates accounts —
# no public signup route exists). GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET
# are NOT needed for login. They'll come back later, scoped to a one-time
# "connect Google Business Profile" flow, decoupled from site login.

# GOOGLE_PLACES_API_KEY= (Phase K — Places API, plain API key, no OAuth)

# Phase F — Core Web Vitals (CrUX + PageSpeed Insights). Plain API key,
# same pattern as Places — can reuse the same Cloud project/key as
# GOOGLE_PLACES_API_KEY if both APIs are enabled on it.
# GOOGLE_PAGESPEED_API_KEY=

# Phase D — GSC + GA4, via a service account (not OAuth, not tied to
# anyone's login). Full service-account JSON key, raw or base64-encoded.
# GOOGLE_SERVICE_ACCOUNT_KEY=
# Then set gscSiteUrl and ga4PropertyId on the Site record, and add the
# service account's email as a user on the Search Console property and
# the GA4 property directly (Google Cloud Console -> Search Console ->
# Settings -> Users; GA4 -> Admin -> Property Access Management).
