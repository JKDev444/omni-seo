// Omni SEO — Database Schema
// Mirrors SEO_Operating_Tracker.xlsx (Audit Scorecard, Monthly Maintenance,
// Citation Tracker, Client Report Log) + Exact_Audit_Methodology.md tiers/states.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ALREADY_COMPLETED
  VERIFIED           // fix confirmed on a later re-crawl
  NOT_CHANGED
  IGNORED            // acknowledged, deliberately not acting on it
  FALSE_POSITIVE      // Step 0.5 protocol: not a real issue
  ACCEPTED            // known tradeoff, won't fix
  THIRD_PARTY         // caused by an app/widget outside our control
  PLATFORM_CONTROLLED // caused by the platform (Shopify default behavior etc.)
  REQUIRES_ADMIN      // blocked on CMS/hosting/DNS access
  REQUIRES_CONTENT    // blocked on a content editor
  REQUIRES_DEVELOPER  // blocked on a developer
}

// Where a finding's evidence came from — server response vs. what a
// browser actually renders after JS runs. A mismatch here (e.g. an H1
// present in rendered but not raw HTML) is itself often the finding.
enum FindingSource {
  RAW_HTML
  RENDERED_DOM
  BOTH
}

enum PageType {
  HOMEPAGE
  SERVICE_PAGE
  BLOG_ARTICLE
  PRODUCT_PAGE
  ABOUT_PAGE
  CONTACT_PAGE
  COLLECTION_PAGE
  SEARCH_PAGE
  UTILITY_PAGE
  OTHER
}

// Internal login only — no public signup route exists, so this table
// itself is the allowlist. Accounts are created via scripts/createUser.ts.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

// One row per domain in scope (v1: omnicenters.com only)
model Site {
  id          String   @id @default(cuid())
  domain      String   @unique
  platform    String   @default("shopify") // shopify | wordpress | webflow | lovable | custom
  gbpPlaceId  String?  // Google Place ID, used to pull public GBP data via Places API
  gbpUrl      String?  // public GBP listing URL, used as the citation entry + manual-entry fallback
  dataForSeoLocationCode Int?    // DataForSEO location_code for SERP targeting (e.g. Olympia-Tumwater metro)
  dataForSeoLanguageCode String? @default("en")
  createdAt   DateTime @default(now())

  pages       Page[]
  crawls      Crawl[]
  citations   Citation[]
  scorecard   ScorecardMetric[]
  maintenance MaintenanceTask[]
  reports     ClientReport[]
  gbpProfile  GbpProfile?
  gscMetrics  GscMetric[]
  ga4Metrics  Ga4Metric[]
  urlInspections UrlInspection[]
  coreWebVitals  CoreWebVitals[]
  internalLinks  InternalLink[]
  contentAnalyses ContentAnalysis[]
  keywords    Keyword[]
  keywordIdeas KeywordIdea[]
  ctrRewriteSuggestions CtrRewriteSuggestion[]
  contentStacks ContentStack[]
  backlinkProfiles BacklinkProfile[]
  backlinkGapDomains BacklinkGapDomain[]
  aiSearchReadiness AiSearchReadiness[]
  seoChangeLogs SeoChangeLog[]

  gscSiteUrl     String? // e.g. "https://omnicenters.com/" or "sc-domain:omnicenters.com"
  ga4PropertyId  String? // GA4 property ID, e.g. "properties/123456789"
}

// Each scheduled/manual crawl run
model Crawl {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  pagesFound  Int      @default(0)
  status      String   @default("running") // running | completed | failed
  findings    Finding[]
  snapshots   PageSnapshot[]
  internalLinks InternalLink[]
  seoChangeLogs SeoChangeLog[]
}

// One row per crawled URL
model Page {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id])
  url           String
  pageType      PageType  @default(OTHER)
  statusCode    Int?
  title         String?
  metaDesc      String?
  canonical     String?
  h1            String?
  schemaTypes   String[]  @default([]) // e.g. ["LocalBusiness","BreadcrumbList"]
  lastCrawledAt DateTime?
  findings      Finding[]
  snapshots     PageSnapshot[]
  contentAnalyses ContentAnalysis[]
  ctrRewriteSuggestions CtrRewriteSuggestion[]
  contentStackMemberships ContentStackMember[]
  aiSearchReadiness AiSearchReadiness[]
  seoChangeLogs SeoChangeLog[]

  @@unique([siteId, url])
}

// One row per (crawl, page) — the actual HTML evidence, kept historically
// so later crawls can diff against it (regression detection, "47 pages
// lost their meta description after a theme update"). rawHtmlHash allows
// cheap change-detection without loading full text for every comparison.
model PageSnapshot {
  id           String   @id @default(cuid())
  crawlId      String
  crawl        Crawl    @relation(fields: [crawlId], references: [id])
  pageId       String
  page         Page     @relation(fields: [pageId], references: [id])
  rawHtml      String
  rawHtmlHash  String
  renderedHtml String?  // null if rendering wasn't available for this crawl
  createdAt    DateTime @default(now())

  // Point-in-time copies of the same signals Page tracks (Page only
  // keeps the latest value) -- needed so regression detection can diff
  // this crawl's snapshot against the previous one per page without
  // re-parsing historical raw HTML every time it runs.
  statusCode   Int?
  title        String?
  metaDesc     String?
  canonical    String?
  h1           String?
  schemaTypes  String[] @default([])

  @@unique([crawlId, pageId])
  @@index([pageId])
}

// One row per issue detected — the core audit output.
// Mirrors Exact_Audit_Methodology.md Step 9 output format exactly.
model Finding {
  id           String        @id @default(cuid())
  crawlId      String
  crawl        Crawl         @relation(fields: [crawlId], references: [id])
  pageId       String?
  page         Page?         @relation(fields: [pageId], references: [id])

  category     String        // technical | local | content | schema | image | redirect
  checkStep    String        // e.g. "Step 1 - Raw HTML", "Step 5 - Local SEO"
  title        String        // short human-readable issue name
  description  String        // why it matters
  fixType      String?       // what to change
  howToTest    String?       // how to confirm it cleared

  priority     Priority
  status       FindingStatus @default(PENDING)
  owner        String?       // developer | content editor | local seo manager

  // How sure the check is (0-100). Deterministic checks (missing tag,
  // wrong status code) are 100. Heuristic ones (content quality, E-E-A-T)
  // should self-report lower so they're never treated as equally certain
  // as a hard technical failure.
  confidence   Int           @default(100)
  // Where to actually make the fix: "Theme Liquid", "Shopify Admin > Page",
  // "Shopify Admin > Redirects", "GBP", "Third-party app", "DNS", "GSC",
  // "Content rewrite" — free text, not an enum, since exact locations vary.
  fixLocation  String?
  source       FindingSource @default(RAW_HTML)

  isFalsePositive Boolean    @default(false) // Step 0.5 protocol result
  detectedAt   DateTime      @default(now())
  resolvedAt   DateTime?
  notes        String?
}

// Mirrors the "Audit Scorecard" tab: baseline vs current vs target
model ScorecardMetric {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  metric    String   // "Technical SEO score", "Indexed pages (GSC)", etc.
  baseline  Float?   // frozen at whatever "current" was the first time this metric was computed from real data -- never touched again
  current   Float?
  target    Float?
  source    String?  // GSC | GA4 | crawler | manual
  updatedAt DateTime @updatedAt

  @@unique([siteId, metric])
}

// Mirrors the "Citation Tracker" tab exactly: Directory / Profile, Public
// URL, Login Owner, Date Created, NAP Consistent, Indexed, Last Checked,
// Notes. Public URLs only — never store passwords/admin URLs here.
model Citation {
  id             String    @id @default(cuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id])
  directory      String    // "Google Business Profile", "Yelp", etc.
  publicUrl      String?
  loginOwner     String?   // who holds/manages the login for this listing
  dateCreated    DateTime? // when the citation/listing was created, not the DB row
  napConsistent  Boolean?
  indexed        Boolean?
  lastCheckedAt  DateTime?
  notes          String?
}

// Cached public-facing Google Business Profile data (Step 5 "GBP public
// data pull"). One row per site, refreshed via Places API or manual entry
// when no GBP manager access is available.
model GbpProfile {
  id              String   @id @default(cuid())
  siteId          String   @unique
  site            Site     @relation(fields: [siteId], references: [id])
  placeId         String?
  name            String?
  primaryCategory String?
  categories      String[] @default([])
  address         String?
  phone           String?
  hours           Json?
  appointmentLink String?
  rating          Float?
  reviewCount     Int?
  photoCount      Int?
  raw             Json?    // full API response, for fields not modeled above
  source          String   @default("manual") // "places_api" | "manual"
  fetchedAt       DateTime @default(now())
}

// Mirrors the "Monthly Maintenance" tab — Week 1-4 cadence
model MaintenanceTask {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id])
  month         String    // "2026-08" — one fresh task set per month, mirrors "duplicate this tab each month"
  week          Int       // 1-4
  area          String    // Technical Crawl | Content + On-Page | Local SEO + Authority | Reporting + Planning
  task          String
  status        String    @default("not_started") // not_started | in_progress | done
  owner         String?
  completedAt   DateTime?
  notes         String?

  @@unique([siteId, month, task])
}

// Mirrors the "Client Report Log" tab
model ClientReport {
  id                   String   @id @default(cuid())
  siteId               String
  site                 Site     @relation(fields: [siteId], references: [id])
  month                String   // "2026-08"
  technicalHealth      String?
  contentImprovements  String?
  localSeo             String?
  performance          String?
  rankingsTraffic      String?
  leadsConversions     String?
  nextMonthPriorities  String?
  createdAt            DateTime @default(now())

  @@unique([siteId, month])
}

// Cached pulls from Google Search Console API (Search Analytics query
// endpoint — the only performance data GSC's API actually exposes).
model GscMetric {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  date         DateTime
  page         String?
  query        String?
  device       String?  // DESKTOP | MOBILE | TABLET
  country      String?
  clicks       Int      @default(0)
  impressions  Int      @default(0)
  ctr          Float    @default(0)
  position     Float    @default(0)
  fetchedAt    DateTime @default(now())

  @@index([siteId, date])
}

// Cached pulls from GA4 Data API
model Ga4Metric {
  id             String   @id @default(cuid())
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id])
  date           DateTime
  page           String?
  sessions       Int      @default(0)
  users          Int      @default(0)
  engagedSessions Int     @default(0)
  conversions    Int      @default(0)
  channelGroup   String?  // Organic Search | Direct | Referral | Paid Search | etc.
  deviceCategory String?  // desktop | mobile | tablet
  source         String?
  fetchedAt      DateTime @default(now())

  @@index([siteId, date])
}

// Cached pulls from the Search Console URL Inspection API — what Google
// actually says about each URL, correlated (in lib/data/indexation.ts)
// against what our own crawler concluded for the same URL. coverageState
// is Google's own display string (no fixed enum contract), so it's kept
// as free text; normalizedStatus is our own derived bucket for counts.
model UrlInspection {
  id                String    @id @default(cuid())
  siteId            String
  site              Site      @relation(fields: [siteId], references: [id])
  url               String
  normalizedStatus  String    // Indexed | Not Indexed | Blocked | Discovered - Not Indexed | Crawled - Not Indexed | Canonical Mismatch
  verdict           String?   // PASS | PARTIAL | FAIL | NEUTRAL
  coverageState     String?   // Google's own display string, e.g. "Submitted and indexed"
  robotsTxtState    String?   // ALLOWED | DISALLOWED
  indexingState     String?   // INDEXING_ALLOWED | BLOCKED_BY_META_TAG | ...
  googleCanonical   String?
  userCanonical     String?
  lastCrawlTime     DateTime?
  richResultsVerdict String?  // PASS | FAIL | NEUTRAL -- Google's own rich-result eligibility verdict, same API call as indexation, no separate integration needed
  richResultsIssues Json?     // [{ richResultType, itemName, severity, issueMessage }] -- ERROR-severity issues block that rich result type in Search
  fetchedAt         DateTime  @default(now())

  @@unique([siteId, url])
}

// Core Web Vitals — CrUX (real-user field data, the metric that actually
// matters for ranking) and PageSpeed Insights (Lighthouse lab diagnostics
// on top of the same CrUX data) are deliberately separate rows via
// `source`, not merged into one shape — they answer different questions
// ("how do real users experience this" vs. "what does a lab audit say to
// fix"). Confirmed the Search Console API has no CWV endpoint at all.
model CoreWebVitals {
  id                String    @id @default(cuid())
  siteId            String
  site              Site      @relation(fields: [siteId], references: [id])
  url               String    // the crawled page URL, or the site origin for origin-level CrUX data
  formFactor        String    // PHONE | DESKTOP
  source            String    // CRUX_FIELD | PSI_LAB
  lcpMs             Float?
  inpMs             Float?
  cls               Float?
  lcpRating         String?   // good | needs-improvement | poor
  inpRating         String?
  clsRating         String?
  performanceScore  Int?      // PSI Lighthouse score, 0-100 — lab only
  topOpportunities  Json?     // PSI Lighthouse audit opportunities — lab only
  isOriginFallback  Boolean   @default(false) // true if per-URL CrUX had no data and this is origin-level instead
  fetchedAt         DateTime  @default(now())

  @@unique([siteId, url, formFactor, source])
}

// One row per internal link found on a crawled page (raw HTML, same
// domain only — external links aren't tracked here). Kept per-crawl
// (not deduped across crawls) so link-graph analysis always reflects
// the latest crawl's actual state, and so link changes over time are
// visible later without a separate history mechanism.
model InternalLink {
  id           String   @id @default(cuid())
  crawlId      String
  crawl        Crawl    @relation(fields: [crawlId], references: [id])
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  sourceUrl    String
  targetUrl    String   // resolved absolute URL, normalized (no hash fragment)
  anchorText   String?
  isContextual Boolean  @default(true) // false = inside <nav>/<header>/<footer>
  createdAt    DateTime @default(now())

  @@index([crawlId])
  @@index([siteId, targetUrl])
}

// LLM-assisted content quality scoring (Step 3 — heading/intent match,
// intro quality, entity coverage, trust/E-E-A-T signals, freshness, CTA
// consistency). contentHash lets a re-run skip pages whose content
// hasn't changed since the last analysis, since each analysis is a real
// API call with a real (small) cost, unlike every other check in this
// project which is free/deterministic.
model ContentAnalysis {
  id                  String   @id @default(cuid())
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id])
  pageId              String
  page                Page     @relation(fields: [pageId], references: [id])
  url                 String
  contentHash         String
  headingIntentScore  Int?
  introQualityScore   Int?
  entityCoverageScore Int?
  trustSignalsScore   Int?
  freshnessScore      Int?
  ctaConsistencyScore Int?
  issues              Json?    // [{ dimension, score, issue }]
  fetchedAt           DateTime @default(now())

  @@unique([siteId, url])
}

// Cached DataForSEO Backlinks Summary — one row per domain (our own,
// isOwnDomain=true, plus each tracked competitor). Full history kept (not
// just latest) so backlink growth/decline is visible over time, same
// pattern as GscMetric/KeywordRanking.
model BacklinkProfile {
  id                       String   @id @default(cuid())
  siteId                   String
  site                     Site     @relation(fields: [siteId], references: [id])
  domain                   String
  isOwnDomain              Boolean  @default(false)
  rank                     Int?
  backlinks                Int?
  referringDomains         Int?
  referringDomainsNofollow Int?
  brokenBacklinks          Int?
  spamScore                Int?
  firstSeen                DateTime?
  fetchedAt                DateTime @default(now())

  @@index([siteId, domain, fetchedAt])
}

// A referring domain that links to a tracked competitor but not to us —
// recomputed client-side from each domain's referring-domains list (not
// DataForSEO's domain_intersection endpoint, whose gap-mode syntax
// couldn't be verified against real behavior) so the result is a set
// difference we can trust, not undocumented API behavior. Replaced
// wholesale on each run, same pattern as ContentStack clustering.
model BacklinkGapDomain {
  id                  String   @id @default(cuid())
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id])
  competitorDomain    String
  referringDomain     String
  referringDomainRank Int?
  backlinksToCompetitor Int?
  fetchedAt           DateTime @default(now())

  @@index([siteId, competitorDomain])
}

enum ContentStackRole {
  PILLAR
  SERVICE_PAGE
  SUPPORTING_ARTICLE
}

// A topical content cluster (e.g. "CoolSculpting", "Botox", "Weight Loss")
// — pillar + service pages + supporting blog articles, mirroring the
// content-stack framework already used for this site's real content
// planning. Membership is LLM-clustered from crawled titles/H1s/pageType
// (cheap: one batch call over all pages, not per-page) since inferring
// ~20+ service groupings from raw crawl data isn't reliably rule-based.
model ContentStack {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  topic     String
  createdAt DateTime @default(now())

  members ContentStackMember[]

  @@unique([siteId, topic])
}

model ContentStackMember {
  id             String           @id @default(cuid())
  contentStackId String
  contentStack   ContentStack     @relation(fields: [contentStackId], references: [id])
  pageId         String
  page           Page             @relation(fields: [pageId], references: [id])
  url            String
  role           ContentStackRole

  @@unique([contentStackId, pageId])
}

// LLM-generated title/meta rewrite suggestions for CTR-opportunity pages
// (high impressions, good position, underperforming CTR — see
// lib/data/keywordAnalysis.ts's detectCtrOpportunities). Cached per URL
// since generation is a real per-page API cost; regenerated only when
// explicitly re-run, not on every page load.
model CtrRewriteSuggestion {
  id                  String   @id @default(cuid())
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id])
  pageId              String
  page                Page     @relation(fields: [pageId], references: [id])
  url                 String
  query               String
  impressions         Int
  ctr                 Float
  avgPosition         Float
  currentTitle        String?
  currentMetaDesc     String?
  suggestedTitle      String
  suggestedMetaDesc   String
  rationale           String
  generatedAt         DateTime @default(now())

  @@unique([siteId, url])
}

// A target keyword to track rank for. targetUrl is the page we intend
// to rank for this term — used for cannibalization detection (another
// owned URL ranking for the same query in GSC data) and to judge
// whether a ranking page matches intent.
model Keyword {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  phrase       String
  targetUrl    String?
  source       String   @default("manual") // manual | gsc_suggested
  searchVolume Int?
  cpc          Float?
  difficulty   Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  rankings     KeywordRanking[]

  @@unique([siteId, phrase])
}

// Keyword discovery ("keyword planner"): candidate keywords the site does
// NOT already track, surfaced from DataForSEO Labs' keyword_ideas endpoint
// seeded from real service-page titles/H1s and existing tracked phrases.
// Deliberately a separate model from Keyword -- an idea is a candidate
// awaiting a decision (track it or not), not something we're rank-checking.
enum KeywordIdeaRecommendation {
  PURSUE
  CONSIDER
  SKIP
}

model KeywordIdea {
  id               String                    @id @default(cuid())
  siteId           String
  site             Site                      @relation(fields: [siteId], references: [id])
  phrase           String
  seedKeyword      String?
  searchVolume     Int?
  cpc              Float?
  competition      Float?
  competitionLevel String?
  difficulty       Int?
  intent           String?
  recommendation   KeywordIdeaRecommendation
  rationale        String
  dismissed        Boolean                   @default(false)
  trackedAsKeywordId String?
  discoveredAt     DateTime                  @default(now())

  @@unique([siteId, phrase])
}

// Phase N: AI Search Readiness — how citeable/extractable this page's
// content is for AI Overviews, ChatGPT, and similar answer engines.
// Deliberately NOT a claim of measuring actual AI-citation rankings
// (that needs a paid tracking service like Otterly.ai/Peec AI) — this
// scores the on-page signals that make citation more likely. Same
// cost-aware caching pattern as ContentAnalysis: a real per-page LLM
// call, cached by content hash, only re-run explicitly.
model AiSearchReadiness {
  id                  String   @id @default(cuid())
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id])
  pageId              String
  page                Page     @relation(fields: [pageId], references: [id])
  url                 String
  contentHash         String
  entityClarityScore  Int?
  citationReadinessScore Int?
  extractabilityScore Int?
  hasAnswerBlock      Boolean  @default(false)
  issues              Json?    // [{ dimension, score, issue }]
  fetchedAt           DateTime @default(now())

  @@unique([siteId, url])
}

// One row per rank-check. Kept as a full history (not just latest) so
// position trends can be charted over time, same pattern as GscMetric.
model KeywordRanking {
  id            String   @id @default(cuid())
  keywordId     String
  keyword       Keyword  @relation(fields: [keywordId], references: [id])
  checkedAt     DateTime @default(now())
  position      Int?     // null = not found in top results checked
  rankingUrl    String?  // which of our URLs actually ranked (may differ from Keyword.targetUrl)
  localPack     Boolean  @default(false) // true if we appeared in the local 3-pack
  aiOverview    Boolean  @default(false) // true if an AI Overview was present in the SERP at all
  serpFeatures  Json?    // raw list of SERP feature types present (featured_snippet, sitelinks, etc.)

  @@index([keywordId, checkedAt])
}

// Project Tracker — a running phase/task board so the user can follow this
// project's build progress without reading git history or README diffs.
// Not tied to a Site (this tracks the tool's own development, not a
// per-client audit), and deliberately simple: a person or an assistant
// working on this codebase updates task status directly (UI buttons or
// scripts/markTask.ts), there's no automated "is this actually done"
// detection here the way Finding status has.
enum ProjectPhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  PARTIAL
  COMPLETE
  SKIPPED
  OUT_OF_SCOPE
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

model ProjectPhase {
  id      String             @id @default(cuid())
  key     String             @unique // "A".."S", or a non-letter key like "AUDIT"
  name    String
  summary String?
  order   Int
  status  ProjectPhaseStatus @default(NOT_STARTED)
  tasks   ProjectTask[]
}

model ProjectTask {
  id          String            @id @default(cuid())
  phaseId     String
  phase       ProjectPhase      @relation(fields: [phaseId], references: [id])
  title       String
  status      ProjectTaskStatus @default(TODO)
  notes       String?
  order       Int
  completedAt DateTime?

  @@unique([phaseId, title])
}

// Phase R: a full changelog of every meaningful on-page field change,
// crawl over crawl -- not just regressions (regressionDetection.ts
// already flags those, prioritized and consolidated). This is the
// complete "what changed and when" record underneath it: every title,
// meta description, canonical, H1, status code, or schema-type-set
// change, whether it made things better, worse, or just different.
model SeoChangeLog {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])
  pageId     String?
  page       Page?    @relation(fields: [pageId], references: [id])
  crawlId    String
  crawl      Crawl    @relation(fields: [crawlId], references: [id])
  field      String   // "title" | "metaDesc" | "canonical" | "h1" | "statusCode" | "schemaTypes"
  oldValue   String?
  newValue   String?
  detectedAt DateTime @default(now())

  @@index([siteId, detectedAt])
  @@index([pageId])
}
